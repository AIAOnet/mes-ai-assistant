# MES Factory Simulation environment template
#
# These credentials are intentionally public, simulation-only defaults. They are
# suitable for a local learning environment, not for an internet-facing system.
# Copy this file to .env before starting the project:
#   Copy-Item .env.example .env                       # PowerShell
#   cp .env.example .env                              # macOS/Linux
#
# Keep the default loopback bind address when using these demo credentials.

# SQL Server (local learning container)
MES_SQL_PASSWORD=MesDemo-Sql-2026!
MES_SQL_CONNECTION=SERVER=127.0.0.1,1433;DATABASE=MesSimulator;UID=sa;PWD=MesDemo-Sql-2026!

# Dashboard server and signed sessions
MES_BIND_ADDRESS=127.0.0.1
MES_DASHBOARD_HOST=127.0.0.1
MES_DASHBOARD_PORT=8000
MES_DASHBOARD_SECRET=mes-demo-only-session-signing-key-2026
MES_COOKIE_SECURE=false
MES_LOG_LEVEL=INFO

# Simulation-only dashboard accounts
MES_ADMIN_USERNAME=admin
MES_ADMIN_PASSWORD=Admin-Demo-2026!
MES_OPERATOR_USERNAME=operator
MES_OPERATOR_PASSWORD=Operator-Demo-2026!
MES_MAINTENANCE_USERNAME=maintenance
MES_MAINTENANCE_PASSWORD=Maintenance-Demo-2026!
MES_ENGINEER_USERNAME=engineer
MES_ENGINEER_PASSWORD=Engineer-Demo-2026!
MES_MANAGER_USERNAME=manager
MES_MANAGER_PASSWORD=Manager-Demo-2026!
MES_VIEWER_USERNAME=viewer
MES_VIEWER_PASSWORD=Viewer-Demo-2026!

# MQTT broker (local mutual-TLS learning setup)
MES_MQTT_PASSWORD=Mqtt-Demo-2026!

# AI assistant (optional). Leave blank to keep the assistant disabled.
# The endpoint must implement OpenAI-compatible chat completions.
MES_AI_API_ENDPOINT=
MES_AI_API_KEY=
MES_AI_MODEL=
MES_AI_TIMEOUT_SECONDS=30

# RAG embeddings (optional). The API key falls back to MES_AI_API_KEY when blank.
MES_RAG_EMBEDDING_ENDPOINT=
MES_RAG_EMBEDDING_API_KEY=
MES_RAG_EMBEDDING_MODEL=
MES_RAG_EMBEDDING_AUTH_HEADER=Authorization
MES_RAG_EMBEDDING_TIMEOUT_SECONDS=45
MES_RAG_SEARCH_MODE=hybrid
MES_RAG_SEMANTIC_WEIGHT=0.65
MES_RAG_DATA_PATH=rag_data

# Ontology search
MES_ONTOLOGY_SEARCH_MODE=hybrid
MES_ONTOLOGY_SEMANTIC_WEIGHT=0.60
# Leave blank to use the default file inside MES_RAG_DATA_PATH.
MES_ONTOLOGY_MANUAL_TRIPLES_PATH=
